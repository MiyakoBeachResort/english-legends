:root {
  --ink:#eef5ff;
  --muted:#a9b8cc;
  --night:#050b16;
  --navy:#08162b;
  --navy-2:#0d2341;
  --panel:#0a1729e8;
  --panel-solid:#0b1727;
  --gold:#edc866;
  --gold-2:#a9782d;
  --gold-soft:#fff1b5;
  --blue:#4ac9ff;
  --blue-2:#246bd7;
  --cyan:#89edff;
  --green:#65d68f;
  --red:#ff6b62;
  --purple:#b38cff;
  --orange:#ff9b47;
  --shadow:0 18px 60px #000b;
  --line:#d6b25b66;
  --safe-top:env(safe-area-inset-top,0px);
  --safe-right:env(safe-area-inset-right,0px);
  --safe-bottom:env(safe-area-inset-bottom,0px);
  --safe-left:env(safe-area-inset-left,0px);
  --hud-h:72px;
  --nav-h:76px;
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;background:var(--night);color:var(--ink);font-family:"Hiragino Sans","Yu Gothic UI","Yu Gothic",Meiryo,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;overscroll-behavior:none}
body{min-height:100dvh;overflow:hidden;touch-action:manipulation}
button,input{font:inherit}
button{color:inherit}
button:focus-visible,input:focus-visible,[tabindex]:focus-visible{outline:3px solid var(--cyan);outline-offset:3px}
button:disabled{opacity:.5;cursor:not-allowed;filter:grayscale(.4)}
img{max-width:100%;display:block}
[hidden]{display:none!important}
.sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}
.app-shell{min-height:100dvh;position:relative;isolation:isolate;background:#06101f;overflow:hidden}
.app-shell:before{content:"";position:fixed;inset:0;pointer-events:none;z-index:100;background:linear-gradient(90deg,#fff0 0 49.7%,#ffffff09 50%,#fff0 50.3%),radial-gradient(circle at 50% 0,#83b9ff0e,transparent 55%);mix-blend-mode:screen}
.boot-screen{height:100dvh;display:grid;place-content:center;gap:18px;text-align:center;background:radial-gradient(circle at 50% 38%,#173a68 0,#08172d 32%,#030812 75%);padding:28px}
.boot-emblem{width:94px;height:94px;margin:auto;border:2px solid var(--gold);border-radius:50%;display:grid;place-items:center;box-shadow:0 0 38px #4ac9ff55,inset 0 0 28px #4ac9ff22;animation:bootPulse 1.8s ease-in-out infinite}
.boot-emblem span{width:45px;height:62px;clip-path:polygon(50% 0,95% 35%,72% 84%,50% 100%,28% 84%,5% 35%);background:linear-gradient(135deg,#d9fbff 3%,#49ccff 42%,#326ddd 70%,#172d7f);filter:drop-shadow(0 0 14px #69e7ff)}
.boot-title{font-family:Georgia,"Times New Roman",serif;font-weight:800;letter-spacing:.14em;color:var(--gold-soft);font-size:clamp(20px,5vw,34px);text-shadow:0 2px 0 #5e3e0c,0 0 20px #ffd66d55}
.boot-progress{width:min(320px,70vw);height:7px;border:1px solid #a88b48;border-radius:99px;background:#020712;overflow:hidden;margin:auto}.boot-progress i{display:block;height:100%;width:52%;background:linear-gradient(90deg,#387eea,#75e7ff,#f6d36f);animation:loadbar 1.3s ease-in-out infinite}
.boot-screen p{color:var(--muted);font-size:13px;margin:0;letter-spacing:.08em}
@keyframes loadbar{0%{transform:translateX(-110%)}100%{transform:translateX(210%)}}
@keyframes bootPulse{50%{transform:scale(1.045);box-shadow:0 0 56px #4ac9ff77,inset 0 0 32px #4ac9ff33}}

/* shared layout */
.screen{position:absolute;inset:0;display:flex;flex-direction:column;overflow:hidden;background:#06101f;animation:screenIn .35s cubic-bezier(.2,.8,.2,1)}
@keyframes screenIn{from{opacity:0;transform:scale(1.015)}to{opacity:1;transform:none}}
.screen-scroll{overflow:auto;-webkit-overflow-scrolling:touch;padding-bottom:calc(var(--nav-h) + var(--safe-bottom) + 24px);scrollbar-width:thin;scrollbar-color:#4e6c91 #07101d}
.cinematic-vignette:after{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse at center,transparent 42%,#02050a88 100%);z-index:1}
.grain{position:absolute;inset:0;opacity:.11;pointer-events:none;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.78' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.35'/%3E%3C/svg%3E");mix-blend-mode:soft-light}
.panel{position:relative;background:linear-gradient(160deg,#132742ee,#07111fee);border:1px solid var(--line);box-shadow:inset 0 1px #fff1,0 14px 36px #0008;border-radius:18px}
.panel:before,.ornate:before{content:"";position:absolute;inset:4px;border:1px solid #f3d67922;border-radius:14px;pointer-events:none}
.eyebrow{font-size:11px;letter-spacing:.18em;color:var(--gold);font-weight:800;text-transform:uppercase}
.section-title{font-family:Georgia,"Yu Mincho",serif;font-size:clamp(22px,4vw,34px);font-weight:800;letter-spacing:.04em;margin:0;text-shadow:0 2px 12px #000}
.subtle{color:var(--muted)}
.gold{color:var(--gold)}
.badge{display:inline-flex;align-items:center;gap:6px;border:1px solid #dcb65766;border-radius:999px;padding:5px 9px;background:#050a13aa;color:var(--gold-soft);font-size:11px;font-weight:800;letter-spacing:.04em}
.divider{height:1px;background:linear-gradient(90deg,transparent,var(--line),transparent);margin:14px 0}

/* buttons */
.btn{min-height:48px;border:1px solid #d8b65e77;border-radius:12px;background:linear-gradient(180deg,#173150,#0a1728);box-shadow:inset 0 1px #ffffff18,0 5px 14px #0008;display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:11px 18px;font-weight:800;letter-spacing:.03em;cursor:pointer;transition:transform .14s ease,filter .14s ease,box-shadow .14s ease;position:relative;overflow:hidden}
.btn:after{content:"";position:absolute;inset:0;background:linear-gradient(110deg,transparent 25%,#fff2 48%,transparent 70%);transform:translateX(-120%);transition:transform .5s ease}
.btn:hover:after{transform:translateX(120%)}
.btn:hover{filter:brightness(1.1);box-shadow:inset 0 1px #ffffff22,0 8px 20px #0009}
.btn:active{transform:translateY(2px) scale(.99)}
.btn-primary{background:linear-gradient(180deg,#327ed7,#194b9e 52%,#0e306d);border-color:#9de7ff;box-shadow:inset 0 1px #fff5,0 0 0 2px #0b1729,0 6px 20px #1c78d866}
.btn-gold{background:linear-gradient(180deg,#f4d880,#b97822 55%,#754315);border-color:#fff1a1;color:#171005;text-shadow:0 1px #fff5;box-shadow:inset 0 1px #fff7,0 0 0 2px #201409,0 8px 24px #e4a42944}
.btn-red{background:linear-gradient(180deg,#de655f,#8a2827);border-color:#ffc1af}
.btn-ghost{background:#02081399;border-color:#8ea3bd55}
.btn-icon{width:48px;min-width:48px;padding:0;border-radius:14px}
.btn-big{min-height:58px;font-size:16px;padding-inline:26px}
.icon{width:20px;height:20px;display:inline-grid;place-items:center;flex:0 0 auto}
.icon svg{width:100%;height:100%;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}

/* Title */
.title-screen{background:#020813}
.title-art{position:absolute;inset:0;background-image:linear-gradient(90deg,#020713dd 0,#02071355 38%,#02071310 70%,#02071388 100%),linear-gradient(0deg,#020713e8 0,transparent 45%),url('assets/hero/party-wide.webp');background-size:cover;background-position:center;transform:scale(1.02);animation:titleDrift 18s ease-in-out infinite alternate}
@keyframes titleDrift{to{transform:scale(1.075) translate3d(-.8%,.4%,0)}}
.title-particles{position:absolute;inset:0;overflow:hidden;pointer-events:none}.title-particles i{position:absolute;width:4px;height:4px;background:#c9f5ff;border-radius:50%;box-shadow:0 0 8px #67dfff;animation:floatParticle var(--d,7s) linear infinite;opacity:0}.title-particles i:nth-child(2n){background:#ffe28b;box-shadow:0 0 9px #ffc95f}.title-particles i:nth-child(3n){width:2px;height:2px}
@keyframes floatParticle{0%{opacity:0;transform:translate3d(0,18px,0)}20%{opacity:.8}80%{opacity:.5}100%{opacity:0;transform:translate3d(var(--x,20px),-90px,0)}}
.title-content{position:relative;z-index:3;height:100%;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;text-align:center;padding:calc(var(--safe-top) + 34px) 24px calc(var(--safe-bottom) + 34px)}
.title-logo{font-family:Georgia,"Times New Roman",serif;font-size:clamp(42px,9vw,92px);line-height:.82;font-weight:900;letter-spacing:-.035em;color:#f8e4a0;background:linear-gradient(#fff7d2 6%,#f3d274 34%,#ad6d1e 72%,#ffeaa0);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;filter:drop-shadow(0 3px 0 #3d2608) drop-shadow(0 6px 22px #000);margin-bottom:14px}
.title-logo span{display:block;font-size:.62em;letter-spacing:.025em}
.title-tagline{font-family:"Yu Mincho",serif;color:#fff6d0;text-shadow:0 2px 8px #000;font-weight:700;font-size:clamp(14px,3vw,21px);letter-spacing:.12em;margin:0 0 24px}
.title-actions{display:grid;gap:10px;width:min(380px,100%)}
.title-version{position:absolute;right:18px;bottom:calc(var(--safe-bottom) + 12px);z-index:3;color:#a8b4c6;font-size:10px;letter-spacing:.12em}
.title-credit{position:absolute;left:18px;bottom:calc(var(--safe-bottom) + 12px);z-index:3;color:#8997aa;font-size:10px}

/* HUD and nav */
.hud{height:calc(var(--hud-h) + var(--safe-top));padding:calc(var(--safe-top) + 9px) max(12px,var(--safe-right)) 9px max(12px,var(--safe-left));display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;align-items:center;background:linear-gradient(180deg,#071326f5,#071326d9);border-bottom:1px solid #d8b45c55;box-shadow:0 8px 28px #0007;z-index:30}
.player-chip{display:flex;align-items:center;gap:10px;min-width:0}.player-avatar{width:48px;height:48px;border-radius:50%;object-fit:cover;border:2px solid var(--gold);box-shadow:0 0 0 3px #091525,0 0 18px #3ebeff55}.player-meta{min-width:0}.player-name-row{display:flex;align-items:baseline;gap:8px}.player-name{font-weight:900;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.player-level{font-size:11px;color:var(--gold);font-weight:900}.xp-track,.hp-track,.enemy-hp-track,.progress-track{height:7px;border-radius:99px;background:#020712;overflow:hidden;border:1px solid #ffffff18;box-shadow:inset 0 1px 4px #000}.xp-track{width:min(210px,38vw);margin-top:5px}.xp-track i,.progress-track i{display:block;height:100%;background:linear-gradient(90deg,#3c80f0,#6ceeff);box-shadow:0 0 8px #4fd9ff}.hud-currencies{display:flex;gap:7px}.currency{height:42px;min-width:72px;padding:0 10px;display:flex;align-items:center;justify-content:center;gap:6px;border:1px solid #d8b55f44;border-radius:12px;background:#020812aa;font-weight:900;font-variant-numeric:tabular-nums}.coin-dot,.gem-dot{width:18px;height:18px;display:inline-block}.coin-dot{border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff5ae,#f1bd35 42%,#aa5d10 75%);border:1px solid #ffe59c;box-shadow:0 0 7px #ffcc4a66}.gem-dot{clip-path:polygon(50% 0,90% 28%,76% 82%,50% 100%,24% 82%,10% 28%);background:linear-gradient(135deg,#e9fbff,#68dfff 38%,#5578ff 74%,#9b5fff);box-shadow:0 0 7px #72dfff}
.bottom-nav{height:calc(var(--nav-h) + var(--safe-bottom));padding:8px max(8px,var(--safe-right)) calc(8px + var(--safe-bottom)) max(8px,var(--safe-left));display:grid;grid-template-columns:repeat(5,1fr);gap:5px;background:linear-gradient(180deg,#071326f0,#030812);border-top:1px solid #d5b55a55;box-shadow:0 -10px 28px #0008;z-index:35}
.nav-btn{min-height:56px;border:0;background:transparent;border-radius:12px;color:#8798b0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;font-weight:800;font-size:10px;cursor:pointer;position:relative}.nav-btn .icon{width:24px;height:24px}.nav-btn.active{color:var(--gold-soft);background:linear-gradient(180deg,#18375e88,#0b192b88);box-shadow:inset 0 0 0 1px #d4b45c44}.nav-btn.active:before{content:"";position:absolute;top:0;width:40%;height:2px;background:var(--gold);box-shadow:0 0 8px var(--gold)}.nav-new{position:absolute;top:4px;right:17%;width:9px;height:9px;border-radius:50%;background:var(--red);box-shadow:0 0 7px var(--red);border:1px solid #fff}

/* Home */
.home-screen{background:#06101f}.home-body{position:relative;flex:1;min-height:0;overflow:auto;padding-bottom:calc(var(--nav-h) + var(--safe-bottom) + 18px);background-image:linear-gradient(90deg,#06101fca 0,#06101f48 52%,#06101f16 75%),linear-gradient(0deg,#06101fe8 0,transparent 48%),url('assets/maps/guild-hall.webp');background-size:cover;background-position:center top}
.home-content{position:relative;z-index:3;padding:22px 16px 26px;max-width:1160px;margin:auto}.welcome{max-width:600px}.welcome h1{font-family:Georgia,"Yu Mincho",serif;margin:6px 0;font-size:clamp(27px,5vw,48px);line-height:1.06;text-shadow:0 3px 18px #000}.welcome p{margin:8px 0 20px;color:#d2dfef;line-height:1.65;text-shadow:0 2px 8px #000}.continue-card{max-width:600px;padding:18px;margin-bottom:18px;background:linear-gradient(140deg,#0c1f39ee,#07111fe8)}.continue-grid{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center}.continue-card h2{margin:4px 0;font-size:18px}.continue-card p{margin:2px 0;color:var(--muted);font-size:13px}.home-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;max-width:700px}.home-card{min-height:112px;padding:16px;text-align:left;cursor:pointer}.home-card h3{margin:5px 0 3px;font-size:16px}.home-card p{margin:0;color:var(--muted);font-size:12px;line-height:1.45}.home-card .card-icon{position:absolute;right:14px;top:14px;width:36px;height:36px;color:var(--gold)}.daily-mini{margin-top:16px;padding:15px;max-width:700px}.daily-row{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center}.daily-row h3{margin:0 0 4px}.daily-row p{margin:0;font-size:12px;color:var(--muted)}

/* Map */
.map-screen{background:#040b14}.map-body{position:relative;flex:1;min-height:0;overflow:hidden;background-image:linear-gradient(#03101f2e,#03101f2e),url('assets/maps/world.webp');background-size:cover;background-position:center}.map-body:after{content:"";position:absolute;inset:0;background:radial-gradient(ellipse at center,transparent 52%,#02060dbd 100%);pointer-events:none}.map-title{position:absolute;top:16px;left:16px;z-index:5;padding:12px 16px;background:#06101fdc;border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow)}.map-title h1{font-size:18px;margin:2px 0}.map-title p{font-size:11px;color:var(--muted);margin:0}.region-node{position:absolute;z-index:6;width:72px;height:72px;border-radius:50%;border:2px solid #f4d676;background:radial-gradient(circle at 35% 30%,#fff6b4,#d59225 38%,#552d0b 67%,#070d17 70%);box-shadow:0 0 0 5px #07111ecc,0 0 28px #ffd05f88;cursor:pointer;display:grid;place-items:center;transition:transform .2s ease,filter .2s ease;animation:nodePulse 2.3s ease-in-out infinite}.region-node:hover{transform:scale(1.08);filter:brightness(1.15)}.region-node.locked{filter:grayscale(1) brightness(.55);border-color:#647386;box-shadow:0 0 0 5px #07111ecc}.region-node.complete{background:radial-gradient(circle at 35% 30%,#d9ffff,#4bd6ff 40%,#265cc7 67%,#071021 70%);box-shadow:0 0 0 5px #07111ecc,0 0 30px #55ddff88}.region-node .node-rune{font-family:Georgia,serif;font-size:25px;font-weight:900;color:#1a1205;text-shadow:0 1px #fff8}.region-node.complete .node-rune{color:#eefcff}.region-node .node-label{position:absolute;top:78px;left:50%;transform:translateX(-50%);white-space:nowrap;background:#030914e8;border:1px solid #d3b45d88;border-radius:8px;padding:5px 8px;font-size:11px;font-weight:900;text-shadow:0 1px 4px #000}.region-node .stars{position:absolute;bottom:-30px;color:#ffd768;font-size:10px;letter-spacing:1px}.region-node .lock-mark{font-size:20px;color:#b9c1cc}.map-route{position:absolute;height:3px;transform-origin:left center;background:repeating-linear-gradient(90deg,#e2c36e 0 8px,transparent 8px 15px);filter:drop-shadow(0 0 5px #ffdb70);z-index:4;opacity:.55}
@keyframes nodePulse{50%{box-shadow:0 0 0 5px #07111ecc,0 0 42px #ffd05faa}}
.map-legend{position:absolute;right:14px;bottom:14px;z-index:7;padding:10px 12px;background:#030914dc;border:1px solid #d3b45d55;border-radius:12px;font-size:11px;color:var(--muted)}

/* Quest drawer */
.quest-drawer{position:absolute;inset:auto 0 0;z-index:20;max-height:72%;overflow:auto;padding:20px 16px calc(var(--safe-bottom) + 20px);background:linear-gradient(180deg,#0d2135f7,#050a12);border-top:1px solid #e0bf6c88;box-shadow:0 -18px 48px #000c;transform:translateY(105%);transition:transform .35s cubic-bezier(.2,.8,.2,1);border-radius:24px 24px 0 0}.quest-drawer.open{transform:none}.drawer-handle{width:46px;height:4px;border-radius:99px;background:#78879b;margin:-7px auto 13px}.drawer-head{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:start;max-width:860px;margin:auto}.drawer-head h2{margin:3px 0;font-size:24px}.drawer-head p{margin:0;color:var(--muted);font-size:12px}.quest-list{display:grid;gap:10px;max-width:860px;margin:16px auto 0}.quest-card{width:100%;min-height:76px;border:1px solid #caaa5c55;border-radius:15px;background:linear-gradient(145deg,#142a45,#091526);display:grid;grid-template-columns:52px 1fr auto;gap:12px;align-items:center;text-align:left;padding:10px 12px;cursor:pointer;box-shadow:inset 0 1px #fff1}.quest-card.locked{filter:grayscale(.8);opacity:.58}.quest-number{width:48px;height:48px;border-radius:13px;display:grid;place-items:center;background:linear-gradient(145deg,#1f79d5,#16366d);border:1px solid #8fddff;font-family:Georgia,serif;font-weight:900;font-size:19px}.quest-card h3{margin:0 0 3px;font-size:15px}.quest-card p{margin:0;color:var(--muted);font-size:11px;line-height:1.4}.quest-stars{font-size:12px;color:#ffd46e;white-space:nowrap}

/* Battle */
.battle-screen{background:#02060c}.battle-scene{position:relative;flex:1;min-height:0;overflow:hidden;background:radial-gradient(circle at 50% 50%,#183a4d,#07111c 68%,#02050a)}.battle-scene[data-biome="forest"]{background:linear-gradient(0deg,#07100fcc,#06101f22),radial-gradient(circle at 50% 22%,#9ccfca44,transparent 30%),linear-gradient(145deg,#1f4a3b,#0d2732 46%,#07111d)}.battle-scene[data-biome="ruins"]{background:radial-gradient(circle at 50% 30%,#93693e33,transparent 36%),linear-gradient(145deg,#332a2e,#131b2b 55%,#070b12)}.battle-scene[data-biome="frost"]{background:radial-gradient(circle at 50% 22%,#d8f8ff55,transparent 30%),linear-gradient(145deg,#5f8ba5,#19374f 55%,#07111d)}.battle-scene[data-biome="fire"]{background:radial-gradient(circle at 50% 45%,#ff6b3038,transparent 30%),linear-gradient(145deg,#4b1d18,#24121a 55%,#07080d)}.battle-scene[data-biome="void"]{background:radial-gradient(circle at 52% 35%,#9d62ff33,transparent 28%),linear-gradient(145deg,#21153b,#101324 55%,#050711)}.battle-scene:before{content:"";position:absolute;inset:0;background-image:linear-gradient(0deg,#050a12 0,transparent 32%),radial-gradient(circle at 50% 130%,#d4bc8555,transparent 44%),url("data:image/svg+xml,%3Csvg width='120' height='120' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 90 Q30 66 60 90T120 90V120H0Z' fill='%230000001b'/%3E%3C/svg%3E");background-size:auto,auto,240px 160px;pointer-events:none}.battle-cloud{position:absolute;width:65vw;height:22vh;left:18%;top:8%;filter:blur(22px);background:#d7f8ff0a;border-radius:50%;animation:cloudDrift 9s ease-in-out infinite alternate}.battle-sparks{position:absolute;inset:0;pointer-events:none;overflow:hidden}.battle-sparks i{position:absolute;width:3px;height:3px;border-radius:50%;background:#ffd56f;box-shadow:0 0 8px #ffb13b;animation:sparkRise var(--d,4s) linear infinite;opacity:0}@keyframes sparkRise{0%{opacity:0;transform:translateY(0) scale(.5)}20%{opacity:.8}100%{opacity:0;transform:translate(var(--x,15px),-170px) scale(1.3)}}@keyframes cloudDrift{to{transform:translateX(10%) scale(1.1)}}
