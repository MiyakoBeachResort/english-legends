.quest-brief-modal{width:min(920px,94vw);max-height:90dvh;display:grid;grid-template-columns:minmax(280px,42%) 1fr;overflow:hidden;padding:0}.quest-brief-visual{position:relative;min-height:470px;background:linear-gradient(#0d263c,#04080d);overflow:hidden}.quest-brief-visual:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,#02060de8,transparent 55%)}.quest-brief-visual img{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 20px 24px #000)}.quest-brief-threat{position:absolute;z-index:2;left:18px;right:18px;bottom:18px;display:grid}.quest-brief-threat small{color:#f2d174}.quest-brief-threat strong{font-size:28px}.quest-brief-threat span{color:#bfcede}.quest-brief-copy{padding:28px;display:flex;flex-direction:column}.quest-brief-copy h2{font-size:36px;margin:6px 0 10px}.quest-brief-copy>p{color:#cbd8e3;font-size:16px;line-height:1.6}.quest-brief-goal{display:flex;gap:13px;margin:18px 0;padding:14px;border:1px solid #d2b85f66;border-radius:16px;background:#081523}.quest-brief-goal>span{width:48px;height:48px;display:grid;place-items:center;border-radius:50%;background:#173f68;color:#ffdf7e}.quest-brief-goal small{display:block;color:#9cb1c2}.quest-brief-goal strong{font-size:20px}.quest-brief-goal p{margin:3px 0 0;color:#c9d6df}.quest-brief-meta{display:flex;gap:8px;flex-wrap:wrap}.quest-brief-meta span{padding:6px 10px;border-radius:999px;background:#13283c;color:#dbe6ee;font-size:12px}.quest-brief-actions{display:grid;grid-template-columns:1fr 2fr;gap:10px;margin-top:auto;padding-top:22px}
.v61-victory-content{width:min(850px,94vw)}.v61-mastery{display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center;margin:15px 0;padding:10px 12px;border-radius:14px;background:#071423}.v61-mastery div{height:10px;border-radius:999px;background:#02070d;overflow:hidden}.v61-mastery i{display:block;height:100%;background:linear-gradient(90deg,#4fc6ff,#f3d36e)}.v61-next-preview{display:grid;margin:14px 0;padding:13px 15px;border:1px solid #e2c56566;border-radius:15px;background:#081522;text-align:left}.v61-next-preview small{color:#d5bc6e}.v61-next-preview strong{font-size:21px}.v61-next-preview span{color:#aebfcd}.v61-victory-actions{display:grid;grid-template-columns:1fr 2fr;gap:10px}
@media(max-width:700px){.v61-hero-stage{grid-template-columns:1fr 145px;gap:9px}.v61-stage-copy{padding:12px 0}.v61-stage-copy h1{font-size:32px}.v61-stage-copy p{font-size:14px;display:none}.v61-stage-party{min-height:175px}.v61-stage-party strong{font-size:20px}.v61-stage-mint{width:53px!important;height:53px!important}.v61-next{padding:15px}.v61-next-main{grid-template-columns:1fr;gap:13px}.v61-next-main h2{font-size:27px}.v61-next-main p{font-size:14px}.v61-next-main .btn{width:100%}.v61-next-foot span{font-size:9px}.v61-progress-node{min-width:128px}.v61-quick-actions{grid-template-columns:repeat(5,1fr);gap:5px}.v61-quick-actions button{min-height:54px;flex-direction:column;gap:2px}.v61-quick-actions span{font-size:9px}.quest-brief-modal{grid-template-columns:1fr;overflow-y:auto}.quest-brief-visual{min-height:250px}.quest-brief-copy{padding:18px}.quest-brief-copy h2{font-size:28px}.quest-brief-goal{margin:12px 0}.quest-brief-actions{position:sticky;bottom:0;background:linear-gradient(transparent,#07101d 20%);padding-top:22px}.v61-victory-actions{grid-template-columns:1fr}.v61-victory-actions .btn-gold{grid-row:1}}
@media(max-width:390px){.v61-hero-stage{grid-template-columns:1fr 125px}.v61-stage-copy h1{font-size:28px}.v61-stage-party{min-height:150px}.v61-next-main h2{font-size:24px}.v61-learning strong{font-size:16px}.v61-progress-node{min-width:118px}.v61-quick-actions span{display:none}.v61-quick-actions button{min-height:48px}.quest-brief-copy h2{font-size:25px}}

/* =========================================================
   v6.2 Soul Awakening
   ========================================================= */
.soul-scene{width:min(920px,94vw);max-height:min(760px,92vh);padding:0;overflow:hidden;display:grid;grid-template-columns:minmax(250px,.95fr) minmax(300px,1.05fr);background:linear-gradient(145deg,rgba(7,20,43,.98),rgba(18,35,62,.98));border:1px solid rgba(227,190,104,.72);box-shadow:0 30px 90px rgba(0,0,0,.58),inset 0 0 0 2px rgba(255,255,255,.03)}
.soul-scene-art{position:relative;min-height:430px;overflow:hidden;background:#071426}.soul-scene-art img{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(1.08) contrast(1.03)}
.soul-scene-art:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent 55%,rgba(7,20,43,.96)),linear-gradient(0deg,rgba(4,12,25,.55),transparent 45%)}
.soul-light{position:absolute;inset:auto 12% 10% 12%;height:42%;background:radial-gradient(circle,rgba(255,224,139,.32),transparent 66%);filter:blur(8px);animation:soulPulse 2.8s ease-in-out infinite}
.soul-scene-copy{padding:clamp(26px,4vw,54px);display:flex;flex-direction:column;justify-content:center;position:relative;z-index:2}.soul-scene-copy h2{font-size:clamp(30px,4vw,48px);margin:.25em 0}.soul-scene-copy>p{font-size:clamp(17px,2vw,21px);line-height:1.8;color:#e9edf5}
.soul-scene blockquote{margin:22px 0;padding:18px 20px;border-left:3px solid #d7ad55;background:rgba(255,255,255,.055);font-family:serif;font-size:clamp(19px,2.3vw,26px);line-height:1.55}.soul-scene blockquote small{display:block;color:#e2bd70;font:700 13px/1.4 system-ui;margin-bottom:7px;letter-spacing:.08em}
.soul-scene-actions{display:flex;justify-content:flex-end;margin-top:12px}.soul-mint{--soul-accent:#72d9b1}.soul-frost{--soul-accent:#8ed8ff}.soul-gold{--soul-accent:#f0c767}.soul-scene .eyebrow{color:var(--soul-accent,#92bfff)}
.soul-bond-card{display:grid;grid-template-columns:92px 1fr auto;align-items:center;gap:18px;padding:16px 20px;margin:14px 0;background:linear-gradient(115deg,rgba(18,48,54,.9),rgba(9,25,45,.95));border-color:rgba(113,217,177,.45)}
.soul-bond-card>img{width:92px;height:92px;object-fit:cover;object-position:center;border-radius:18px;border:1px solid rgba(166,245,215,.48);background:#143b3d}.soul-bond-card h3{font-size:21px;margin:2px 0}.soul-bond-card p{margin:3px 0 10px;color:#dbe8e7}.soul-bond-card>strong{padding:7px 12px;border-radius:999px;background:rgba(92,213,170,.14);color:#9cf0ce;border:1px solid rgba(123,231,192,.35)}
.soul-bond-meter{height:8px;border-radius:999px;background:rgba(0,0,0,.35);overflow:hidden}.soul-bond-meter i{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#4dc49b,#c4f7c8);box-shadow:0 0 14px rgba(82,211,166,.62)}
@keyframes soulPulse{50%{transform:scale(1.12);opacity:.72}}
@media(max-width:700px){.soul-scene{grid-template-columns:1fr;max-height:94vh;overflow:auto}.soul-scene-art{min-height:250px;max-height:34vh}.soul-scene-art:after{background:linear-gradient(0deg,rgba(7,20,43,.98),transparent 58%)}.soul-scene-copy{padding:22px}.soul-scene-copy h2{font-size:30px}.soul-scene-copy>p{font-size:17px}.soul-bond-card{grid-template-columns:68px 1fr}.soul-bond-card>img{width:68px;height:68px}.soul-bond-card>strong{grid-column:2;justify-self:start}}
.soul-battle-line{position:absolute;left:clamp(12px,3vw,36px);bottom:clamp(250px,34vh,360px);z-index:14;display:flex;align-items:center;gap:10px;max-width:min(430px,82vw);padding:10px 14px 10px 9px;border:1px solid rgba(122,226,191,.38);border-radius:16px;background:linear-gradient(110deg,rgba(8,30,38,.94),rgba(7,18,37,.93));box-shadow:0 12px 30px rgba(0,0,0,.38);animation:soulLineIn .45s ease-out both}.soul-battle-line img{width:54px;height:54px;object-fit:cover;border-radius:14px;background:#123c3a}.soul-battle-line small{display:block;color:#8fe3c1;font-weight:800;letter-spacing:.05em}.soul-battle-line strong{display:block;margin-top:2px;font-size:15px;line-height:1.45;color:#f4fbf8}@keyframes soulLineIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}@media(max-width:700px){.soul-battle-line{position:relative;left:auto;bottom:auto;margin:8px 12px;max-width:none}.soul-battle-line img{width:46px;height:46px}.soul-battle-line strong{font-size:14px}}
